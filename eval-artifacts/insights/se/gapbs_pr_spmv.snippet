    36d4:  ldr     s1, [x3, x1, lsl #2]      label:  outgoing_contrib    PageRankPull

    // scores[u] (direct, pr_spmv.cc:90-91)
    36ec:  ldr     s1, [x5, x4, lsl #2]      label:  scores              PageRankPull
ret 377c

