// The neighbour load is post-indexed, a macro-op in gem5 (see gapbs_pr).
offset: 0
func PageRankPull_omp_fn_1:
    // in_index_[u] (direct)
    36bc:  ldr     x0, [x6, x4, lsl #3]      label:  in_index            main

    // outgoing_contrib[v] for v in in_neigh(u) (pr_spmv.cc:88-89)
